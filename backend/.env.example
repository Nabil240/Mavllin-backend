# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:4200

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ecommerce_db

# JWT Authentication
JWT_SECRET=replace_with_a_strong_secret_key
JWT_EXPIRES_IN=7d

# Unified Messaging & Meta APIs
MESSAGING_MODE=mock
FB_VERIFY_TOKEN=mavllin_fb_verify_token_2026
FB_PAGE_ACCESS_TOKEN=EAAB...
FB_APP_SECRET=mavllin_fb_app_secret_example
WHATSAPP_VERIFY_TOKEN=mavllin_wa_verify_token_2026
WHATSAPP_ACCESS_TOKEN=EAAB...
WHATSAPP_PHONE_NUMBER_ID=100609...
WHATSAPP_APP_SECRET=mavllin_wa_app_secret_example

# N8N Order Webhook & DeepSeek Automation
